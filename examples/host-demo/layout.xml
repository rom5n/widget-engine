<widget xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../schemas/layout.xsd">
  <!-- Fed by crates/engine/examples/host_demo.rs while Calmdesk shows it. -->
  <column width="fill" height="fill" align="center" justify="center" gap="8">
    <text value="{app.count}" size="44" weight="700" features="tnum"/>
    <text value="{app.status}" size="12" color="secondary"/>
    <stack action="reset" padding="6 14" radius="14" corners="round" fill="#8080802E" hover.fill="#80808050">
      <text value="Reset" size="13" weight="600"/>
    </stack>
  </column>
</widget>
