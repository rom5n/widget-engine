<widget xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../schemas/layout.xsd">
  <!-- Month view in the style of the macOS Calendar widget. Generated by a script; the grid is
       42 cells bound to the built-in cal.* values (cal.d = day, cal.t = today, cal.c = color). -->
  <style class="day" grow="1" height="fill"/>
  <style class="week" width="fill" grow="1"/>
  <style class="heads" width="fill" height="16"/>
  <style class="now" weight="700" color="#FFFFFF"/>
  <style class="num" size="11" weight="600" features="tnum"/>
  <style class="head" size="9" weight="700" color="secondary"/>
  <style class="today" width="19" height="19" fill="#FF3B30"/>
  <column padding="11 10 9 10">
    <text value="{cal.month}" size="11" weight="700" tracking="0.4" color="#FF3B30" padding="0 4 4 4"/>
    <row class="heads">
      <stack class="day"><text class="head" value="{cal.wd0}"/></stack>
      <stack class="day"><text class="head" value="{cal.wd1}"/></stack>
      <stack class="day"><text class="head" value="{cal.wd2}"/></stack>
      <stack class="day"><text class="head" value="{cal.wd3}"/></stack>
      <stack class="day"><text class="head" value="{cal.wd4}"/></stack>
      <stack class="day"><text class="head" value="{cal.wd5}"/></stack>
      <stack class="day"><text class="head" value="{cal.wd6}"/></stack>
    </row>
    <row class="week">
      <stack class="day"><ellipse class="today" if="cal.t0"/><text class="num" if="!cal.t0" value="{cal.d0}" color="{cal.c0}"/><text class="num now" if="cal.t0" value="{cal.d0}"/></stack>
      <stack class="day"><ellipse class="today" if="cal.t1"/><text class="num" if="!cal.t1" value="{cal.d1}" color="{cal.c1}"/><text class="num now" if="cal.t1" value="{cal.d1}"/></stack>
      <stack class="day"><ellipse class="today" if="cal.t2"/><text class="num" if="!cal.t2" value="{cal.d2}" color="{cal.c2}"/><text class="num now" if="cal.t2" value="{cal.d2}"/></stack>
